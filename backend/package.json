{
  "name": "rongzhi-agent-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "融智 Agent 后端服务",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:init": "node scripts/init-db.js",
    "cloud:init": "node scripts/init-cloudbase.js",
    "cloud:bind-verification": "node scripts/bind-verification-cloud.js",
    "cloud:verify:sql": "node scripts/cloud/verify-sql.js",
    "cloud:verify:api": "node scripts/cloud/verify-api.js",
    "cloud:verify:assistant": "node scripts/cloud/verify-assistant.js",
    "cloud:verify": "npm run cloud:verify:sql && npm run cloud:verify:races && npm run cloud:verify:api && npm run cloud:verify:assistant",
    "ai:check": "node scripts/ai-check.js",
    "cloud:verify:races": "node scripts/cloud/verify-races.js",
    "verify:receipts": "node scripts/verify-authoritative-receipts.js",
    "verify:audit": "node scripts/verify-audit.js",
    "verify:sandbox": "node scripts/verify-sandbox.js",
    "verify:security": "node scripts/verify-security-controls.js",
    "verify:workflows": "node scripts/verify-workflows.js",
    "verify:competition": "npm run verify:receipts && npm run verify:audit && npm run verify:sandbox && npm run verify:security && npm run verify:workflows"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "quickjs-emscripten": "^0.32.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20.12 <25"
  }
}
