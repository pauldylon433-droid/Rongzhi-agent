# DeepSeek API 配置模板。
# 使用方式：复制本文件为 backend/.env 后填入真实密钥；.env 已加入 .gitignore，不会提交到版本控制。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# —— 公网演示（Render 等；本地不需要）——
# PUBLIC_DEMO=1                     # 显式开启公网演示模式（独立演示库 + 访问口令）
# DEMO_ACCESS_PASSWORD=             # 必填：共享访问口令（服务端 Basic Auth，覆盖页面与业务 API）
# PUBLIC_AI_ENABLED=0               # 默认关闭；显式设为 1 才允许自然语言助手
# PUBLIC_AI_RATE_LIMIT_PER_MIN=6    # 开启 AI 时必填：每 IP 每分钟请求上限
# PUBLIC_AI_DAILY_CALL_QUOTA=200    # 开启 AI 时必填：每日模型调用总数（含工具循环内调用）
# PUBLIC_AI_MAX_CONCURRENCY=2       # 开启 AI 时必填：同时进行的模型调用上限
# VERIFICATION_KEY=                 # 公网强验证主密钥（base64 32 字节；公网模式不读本地文件）
# DEMO_VERIFICATION_PASSWORD=       # 公网首次绑定的交易密码（≥8 位）
# DEMO_TOTP_SECRET=                 # 公网首次绑定的 TOTP Base32 密钥（≥16 字符）
