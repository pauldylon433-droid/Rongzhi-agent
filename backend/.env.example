# DeepSeek API 配置模板。
# 使用方式：复制本文件为 backend/.env 后填入真实密钥；.env 已加入 .gitignore，不会提交到版本控制。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# —— 数据库模式 ——
# 本地默认 sqlite（保留现有行为）；公网持久演示必须显式配置 cloudbase。
# DB_MODE=cloudbase
# CLOUDBASE_RPC_BASE=https://<envId>.api.tcloudbasegateway.com   # 只填站点根地址
# CLOUDBASE_SERVICE_KEY=                                        # 仅后端环境变量，严禁进前端 / 仓库 / 日志
# CLOUDBASE_DEMO_USER_ID=1                                      # 云端独立演示用户 id

# 云端强验证：只由后端持有；TOTP 密钥用 VERIFICATION_KEY 加密后写入数据库。
# VERIFICATION_KEY=                                             # base64 32 字节
# DEMO_VERIFICATION_PASSWORD=                                   # 首次绑定用交易密码（≥8 位）
# DEMO_TOTP_SECRET=                                             # 首次绑定用 TOTP Base32 密钥

# —— 公网演示（Render 等；本地不需要）——
# PUBLIC_DEMO=1                     # 显式开启公网演示模式（独立演示库 + 访问口令）
# DEMO_ACCESS_PASSWORD=             # 必填：共享访问口令（服务端 Basic Auth，覆盖页面与业务 API）
# PUBLIC_AI_ENABLED=0               # 默认关闭；显式设为 1 才允许自然语言助手
# PUBLIC_AI_RATE_LIMIT_PER_MIN=6    # 开启 AI 时必填：每 IP 每分钟请求上限
# PUBLIC_AI_DAILY_CALL_QUOTA=200    # 开启 AI 时必填：每日模型调用总数（含工具循环内调用）
# PUBLIC_AI_MAX_CONCURRENCY=2       # 开启 AI 时必填：同时进行的模型调用上限
# VERIFICATION_KEY=                 # 公网强验证主密钥（base64 32 字节；公网模式不读本地文件）
# DEMO_VERIFICATION_PASSWORD=       # 公网首次绑定的交易密码（≥8 位）
# DEMO_TOTP_SECRET=                 # 公网首次绑定的 TOTP Base32 密钥（≥16 字符）

# —— 安全控制（可选；默认值如下）——
# SECURITY_ANOMALY_ENABLED=1
# SECURITY_ANOMALY_WINDOW_SECONDS=300
# SECURITY_ANOMALY_THRESHOLD=5
# SECURITY_ANOMALY_LOCK_SECONDS=900
# MODEL_BREAKER_THRESHOLD=3
# MODEL_BREAKER_COOLDOWN_MS=60000
# AUDIT_ACCESS_TOKEN=            # 不配置则审计查询 / 导出接口返回 404；配置后必须保密
